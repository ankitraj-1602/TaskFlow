# Server
PORT=5000
NODE_ENV=production

# Database (inside Docker network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=taskflow_user
DB_PASSWORD=taskflow_password
DB_NAME=taskflow

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CLIENT_URL=http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Email (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=660395f29f61ea
SMTP_PASS=71331302f41699
EMAIL_FROM="TaskFlow <noreply@taskflow.dev>"

# Verification token expiry (in hours)
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Redis (inside Docker network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Cache
CACHE_TTL_SECONDS=300

# Uploads
UPLOAD_DIR=/app/uploads